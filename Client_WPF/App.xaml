<Application x:Class="RemoteDesktopClient.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="AppFontFamily">pack://application:,,,/Assets/Fonts/#SF Pro Display, Segoe UI, sans-serif</FontFamily>
            <FontFamily x:Key="AppFontFamilySemibold">pack://application:,,,/Assets/Fonts/#SF Pro Display, Segoe UI Semibold, sans-serif</FontFamily>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/LightTheme.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
