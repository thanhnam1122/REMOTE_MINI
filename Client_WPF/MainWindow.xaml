<Window x:Class="RemoteDesktopClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Mini · Chia sẻ màn hình"
        Width="1220" Height="820"
        MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Product bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="42" Height="42" Margin="0,0,13,0">
                        <Border Background="{DynamicResource BrandGradientBrush}" CornerRadius="13"/>
                        <Path Data="M1,1 L25,1 L25,17 L1,17 Z M8,22 L18,22 M13,17 L13,22"
                              Width="26"
                              Height="23"
                              Stroke="{DynamicResource OnAccentBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="REMOTE MINI" FontFamily="Segoe UI Semibold" FontSize="16"/>
                        <TextBlock Text="Chia sẻ màn hình an toàn" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="6"
                            Padding="7,3"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="SHARE" Style="{StaticResource SectionEyebrowStyle}" FontSize="9"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="borderStatusPill"
                            Background="{DynamicResource DangerSoftBrush}"
                            BorderBrush="{DynamicResource DangerBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="12,7"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ellipseStatus"
                                     Width="8" Height="8"
                                     Fill="{DynamicResource DangerBrush}"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtStatus"
                                       Text="Chưa kết nối"
                                       FontFamily="Segoe UI Semibold"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="btnScreenshot"
                            Content="Chụp màn hình"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,10,0"
                            Click="BtnScreenshot_Click"
                            ToolTip="Chụp và lưu màn hình máy này"/>
                    <Button x:Name="btnToggleFullscreen"
                            Content="Toàn màn hình"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,10,0"
                            Click="BtnToggleFullscreen_Click"
                            ToolTip="Bật/tắt chế độ toàn màn hình (F11 hoặc Esc để thoát)"/>
                    <Button x:Name="btnToggleTheme"
                            Content="Sáng"
                            Width="68"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnToggleTheme_Click"
                            ToolTip="Chuyển giao diện sáng hoặc tối"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Workspace -->
        <Grid Grid.Row="1" Margin="22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="396"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Connection and capture controls -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="22">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="58" Height="58" Margin="0,0,14,0">
                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="18"/>
                                <Path Data="M17,28 C17,22 21,18 27,18 L38,18 M41,28 C41,34 37,38 31,38 L20,38 M24,23 L18,29 L24,35 M34,23 L40,29 L34,35"
                                      Stroke="{DynamicResource AccentBrush}"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="KẾT NỐI MÁY ĐIỀU KHIỂN" Style="{StaticResource SectionEyebrowStyle}"/>
                                <TextBlock Text="Bắt đầu phiên hỗ trợ" Style="{StaticResource CardTitleStyle}" FontSize="23" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Nhập thông tin do người hỗ trợ cung cấp. Màn hình chỉ được truyền khi phiên kết nối thành công."
                                   Style="{StaticResource BodyTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="ĐỊA CHỈ IP MÁY CHỦ" Style="{StaticResource InputLabelStyle}"/>
                        <TextBox x:Name="txtIp" Text="127.0.0.1" Style="{StaticResource TextInputStyle}" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="CỔNG" Style="{StaticResource InputLabelStyle}"/>
                                <TextBox x:Name="txtPort" Text="8888" Style="{StaticResource TextInputStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="MÃ PIN" Style="{StaticResource InputLabelStyle}"/>
                                <TextBox x:Name="txtPin" Text="1234" Style="{StaticResource TextInputStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Button x:Name="btnConnect"
                                Content="Kết nối và chia sẻ"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,16,0,0"
                                Click="BtnConnect_Click"/>

                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="20" MinHeight="238">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="CHẤT LƯỢNG CHIA SẺ" Style="{StaticResource SectionEyebrowStyle}"/>
                            <TextBlock Text="Điều chỉnh trước hoặc trong phiên" Style="{StaticResource BodyTextStyle}" Margin="0,3,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,16,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <Grid>
                                    <TextBlock Text="Chất lượng JPEG" Style="{StaticResource InputLabelStyle}"/>
                                    <TextBlock x:Name="txtQualityVal" Text="100%" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" FontFamily="{DynamicResource AppFontFamilySemibold}" FontSize="11"/>
                                </Grid>
                                <Slider x:Name="sldQuality" Minimum="10" Maximum="100" Value="100" TickFrequency="5" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}" ValueChanged="SldQuality_ValueChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock Text="Tỉ lệ khung hình" Style="{StaticResource InputLabelStyle}"/>
                                    <TextBlock x:Name="txtScaleVal" Text="1.00x" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" FontFamily="{DynamicResource AppFontFamilySemibold}" FontSize="11"/>
                                </Grid>
                                <Slider x:Name="sldScale" Minimum="0.25" Maximum="1" Value="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}" ValueChanged="SldScale_ValueChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                                <Grid>
                                    <TextBlock Text="Giới hạn FPS" Style="{StaticResource InputLabelStyle}"/>
                                    <TextBlock x:Name="txtFpsVal" Text="120 FPS" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" FontFamily="{DynamicResource AppFontFamilySemibold}" FontSize="11"/>
                                </Grid>
                                <Slider x:Name="sldFps" Minimum="5" Maximum="120" Value="120" TickFrequency="5" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}" ValueChanged="SldFps_ValueChanged"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            </ScrollViewer>

            <!-- Telemetry and activity -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="190"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="2,0,2,12">
                            <StackPanel>
                                <TextBlock Text="SỨC KHỎE PHIÊN" Style="{StaticResource SectionEyebrowStyle}"/>
                                <TextBlock Text="Dữ liệu truyền theo thời gian thực" Style="{StaticResource BodyTextStyle}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Text="LIVE TELEMETRY" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource MetricLabelStyle}"/>
                        </Grid>

                        <UniformGrid Grid.Row="1" Columns="4" Rows="1">
                            <Border Style="{StaticResource InsetCardStyle}" Margin="0,0,6,0" Padding="13">
                                <StackPanel>
                                    <TextBlock Text="TỐC ĐỘ GỬI" Style="{StaticResource MetricLabelStyle}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <TextBlock x:Name="txtFps" Text="0.0" Style="{StaticResource MetricValueStyle}" Foreground="{DynamicResource SuccessBrush}"/>
                                        <TextBlock Text=" fps" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Bottom" Margin="3,0,0,4"/>
                                    </StackPanel>
                                    <TextBlock Text="Khung hình / giây" Style="{StaticResource BodyTextStyle}" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InsetCardStyle}" Margin="6,0" Padding="13">
                                <StackPanel>
                                    <TextBlock Text="BĂNG THÔNG" Style="{StaticResource MetricLabelStyle}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <TextBlock x:Name="txtBandwidth" Text="0.0" Style="{StaticResource MetricValueStyle}" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text=" KB/s" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Bottom" Margin="3,0,0,4"/>
                                    </StackPanel>
                                    <TextBlock Text="Dữ liệu đang gửi" Style="{StaticResource BodyTextStyle}" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InsetCardStyle}" Margin="6,0" Padding="13">
                                <StackPanel>
                                    <TextBlock Text="ĐỘ PHÂN GIẢI" Style="{StaticResource MetricLabelStyle}"/>
                                    <TextBlock x:Name="txtResolution" Text="1920×1080" Style="{StaticResource MetricValueStyle}" FontSize="17" Margin="0,10,0,0"/>
                                    <TextBlock Text="Kích thước màn hình" Style="{StaticResource BodyTextStyle}" FontSize="10" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InsetCardStyle}" Margin="6,0,0,0" Padding="13">
                                <StackPanel>
                                    <TextBlock Text="TỔNG DỮ LIỆU" Style="{StaticResource MetricLabelStyle}"/>
                                    <TextBlock x:Name="txtTotalData" Text="0 MB" Style="{StaticResource MetricValueStyle}" FontSize="17" Margin="0,10,0,0"/>
                                    <TextBlock Text="Từ đầu phiên hiện tại" Style="{StaticResource BodyTextStyle}" FontSize="10" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="62"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="42"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="20,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="NHẬT KÝ HOẠT ĐỘNG" Style="{StaticResource SectionEyebrowStyle}"/>
                                <TextBlock Text="Theo dõi kết nối, khung hình và lệnh điều khiển" Style="{StaticResource BodyTextStyle}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Content="Xóa nhật ký" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource TextButtonStyle}" Click="BtnClearLog_Click"/>
                        </Grid>

                        <Border Grid.Row="1"
                                Margin="12,0"
                                Background="{DynamicResource ConsoleBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="10">
                            <TextBox x:Name="txtLogs" Style="{StaticResource ConsoleTextBoxStyle}" FontSize="12"/>
                        </Border>

                        <Grid Grid.Row="2" Margin="20,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="TCP · JPEG DELTA STREAM" Style="{StaticResource MetricLabelStyle}"/>
                            </StackPanel>
                            <TextBlock Text="Remote Mini 1.0" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}" FontSize="10"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
