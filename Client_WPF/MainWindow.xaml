<Window x:Class="RemoteDesktopClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Desktop Mini - WPF Client"
        Height="720" Width="1100"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.Resources>
        <!-- Custom Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#374151"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom TextBox Style -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#11131F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Metric Card Label Style -->
        <Style x:Key="MetricTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Panel -->
        <Border Grid.Row="0" Background="{StaticResource CardDarkBrush}" CornerRadius="10" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" Padding="20,16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡ REMOTE DESKTOP MINI" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <Border Background="#2563EB" CornerRadius="10" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="WPF NATIVE CLIENT" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Máy bị điều khiển (Client) - Truyền luồng ảnh nén JPEG &amp; Nhận thao tác điều khiển" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Status Pill -->
                <Border Grid.Column="1" x:Name="borderStatusPill" Background="#1F2937" CornerRadius="20" Padding="14,6" VerticalAlignment="Center" BorderBrush="#374151" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ellipseStatus" Width="10" Height="10" Fill="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtStatus" Text="Đã ngắt kết nối" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Body Grid (2 Columns) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Controls & Metrics -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                <StackPanel Orientation="Vertical">
                    <!-- Connection Config Card -->
                    <Border Background="{StaticResource CardDarkBrush}" CornerRadius="10" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" Padding="18" Margin="0,0,0,14">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="CẤU HÌNH KẾT NỐI SERVER" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                            <TextBlock Text="Địa chỉ IP Server:" FontSize="12" Foreground="White" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtIp" Text="127.0.0.1" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Cổng (Port):" FontSize="12" Foreground="White" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtPort" Text="8888" Style="{StaticResource ModernTextBoxStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Mã PIN Xác Thực:" FontSize="12" Foreground="White" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtPin" Text="1234" Style="{StaticResource ModernTextBoxStyle}"/>
                                </StackPanel>
                            </Grid>

                            <Button x:Name="btnConnect" Content="🚀 Bắt đầu Kết nối Server" Style="{StaticResource ModernButtonStyle}" Click="BtnConnect_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Realtime Dashboard Card -->
                    <Border Background="{StaticResource CardDarkBrush}" CornerRadius="10" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" Padding="18" Margin="0,0,0,14">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="THÔNG SỐ TRUYỀN TẢI THỜI GIAN THỰC" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                            <UniformGrid Columns="2" Rows="2">
                                <!-- FPS -->
                                <Border Background="#11131F" CornerRadius="8" Padding="12" Margin="0,0,6,12" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="TỐC ĐỘ KHUNG HÌNH" Style="{StaticResource MetricTitleStyle}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="txtFps" Text="0.0" Style="{StaticResource MetricValueStyle}" Foreground="#10B981"/>
                                            <TextBlock Text=" FPS" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Bandwidth -->
                                <Border Background="#11131F" CornerRadius="8" Padding="12" Margin="6,0,0,12" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="BĂNG THÔNG GỬI" Style="{StaticResource MetricTitleStyle}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="txtBandwidth" Text="0.0" Style="{StaticResource MetricValueStyle}" Foreground="#3B82F6"/>
                                            <TextBlock Text=" KB/s" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Resolution -->
                                <Border Background="#11131F" CornerRadius="8" Padding="12" Margin="0,0,6,0" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="ĐỘ PHÂN GIẢI GỐC" Style="{StaticResource MetricTitleStyle}"/>
                                        <TextBlock x:Name="txtResolution" Text="1920x1080" Style="{StaticResource MetricValueStyle}" Foreground="#F59E0B" FontSize="16"/>
                                    </StackPanel>
                                </Border>

                                <!-- Total Bytes -->
                                <Border Background="#11131F" CornerRadius="8" Padding="12" Margin="6,0,0,0" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="TỔNG DỮ LIỆU" Style="{StaticResource MetricTitleStyle}"/>
                                        <TextBlock x:Name="txtTotalData" Text="0 MB" Style="{StaticResource MetricValueStyle}" Foreground="#8B5CF6" FontSize="16"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Stream Capture Settings Card -->
                    <Border Background="{StaticResource CardDarkBrush}" CornerRadius="10" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" Padding="18">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="CẤU HÌNH NÉN &amp; CHỤP MÀN HÌNH" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                            <!-- Quality Slider -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Chất lượng JPEG (Quality):" FontSize="12" Foreground="White" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="txtQualityVal" Text="55%" FontSize="12" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="sldQuality" Minimum="10" Maximum="100" Value="55" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SldQuality_ValueChanged" Margin="0,0,0,14"/>

                            <!-- Scale Slider -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Tỉ lệ thu nhỏ (Scale):" FontSize="12" Foreground="White" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="txtScaleVal" Text="0.50x" FontSize="12" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="sldScale" Minimum="0.25" Maximum="1.0" Value="0.5" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="SldScale_ValueChanged" Margin="0,0,0,14"/>

                            <!-- FPS Slider -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Giới hạn FPS (FPS Limit):" FontSize="12" Foreground="White" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="txtFpsVal" Text="30 FPS" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="sldFps" Minimum="5" Maximum="60" Value="30" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SldFps_ValueChanged"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right Column: Console Log Window -->
            <Border Grid.Column="1" Background="{StaticResource CardDarkBrush}" CornerRadius="10" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="💻 NHẬT KÝ HOẠT ĐỘNG (SYSTEM LOGS)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Button Content="Xóa Logs" FontSize="11" Padding="8,4" Background="#374151" Foreground="White" HorizontalAlignment="Right" Click="BtnClearLog_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Background="#0A0C10" CornerRadius="8" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" Padding="12">
                        <TextBox x:Name="txtLogs" FontFamily="Consolas" FontSize="12" Foreground="#38BDF8" Background="Transparent" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
