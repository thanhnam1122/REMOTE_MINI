<Window x:Class="RemoteDesktopServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Mini · Bảng điều khiển"
        Width="1360" Height="850"
        MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Grid x:Name="rootGrid" Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Product bar -->
        <Border x:Name="borderProductBar"
                Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="42" Height="42" Margin="0,0,13,0">
                        <Border Background="{DynamicResource BrandGradientBrush}" CornerRadius="13"/>
                        <Path Data="M1,1 L25,1 L25,17 L1,17 Z M8,22 L18,22 M13,17 L13,22"
                              Width="26"
                              Height="23"
                              Stroke="{DynamicResource OnAccentBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="REMOTE MINI" FontFamily="Segoe UI Semibold" FontSize="16"/>
                        <TextBlock Text="Bảng điều khiển từ xa" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="6"
                            Padding="7,3"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="CONTROL" Style="{StaticResource SectionEyebrowStyle}" FontSize="9"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="borderStatusPill"
                            Background="{DynamicResource WarningSoftBrush}"
                            BorderBrush="{DynamicResource WarningBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="12,7"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ellipseStatus"
                                     Width="8" Height="8"
                                     Fill="{DynamicResource WarningBrush}"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtStatus"
                                       Text="Đang khởi động máy chủ..."
                                       FontFamily="Segoe UI Semibold"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="btnScreenshotTop"
                            Content="Chụp màn hình"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,10,0"
                            Click="BtnScreenshot_Click"
                            ToolTip="Chụp và lưu hình ảnh màn hình từ xa"/>
                    <Button x:Name="btnToggleFullscreenTop"
                            Content="Toàn màn hình"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,10,0"
                            Click="BtnToggleFullscreen_Click"
                            ToolTip="Bật/tắt chế độ toàn màn hình (F11 hoặc Esc để thoát)"/>
                    <Button x:Name="btnToggleTheme"
                            Content="Sáng"
                            Width="68"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnToggleTheme_Click"
                            ToolTip="Chuyển giao diện sáng hoặc tối"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Workspace -->
        <Grid x:Name="gridWorkspace" Grid.Row="1" Margin="22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="colRightSidebarGap" Width="16"/>
                <ColumnDefinition x:Name="colRightSidebar" Width="356"/>
            </Grid.ColumnDefinitions>

            <!-- Remote screen and stream controls -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition x:Name="rowStreamSettingsGap" Height="16"/>
                    <RowDefinition x:Name="rowStreamSettings" Height="184"/>
                </Grid.RowDefinitions>

                <Border x:Name="cardRemoteScreen" Grid.Row="0" Style="{StaticResource CardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="rowHeaderRemoteScreen" Height="62"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid x:Name="headerRemoteScreen" Margin="18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Màn hình từ xa" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock Text="Nhấp vào khung hình để truyền chuột và bàn phím"
                                           Style="{StaticResource BodyTextStyle}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="btnToggleFullscreen"
                                        Content="Toàn màn hình"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="12,6"
                                        Margin="0,0,10,0"
                                        Click="BtnToggleFullscreen_Click"
                                        ToolTip="Bật/tắt chế độ toàn màn hình (F11 hoặc Esc để thoát)"/>
                                <Button x:Name="btnScreenshot"
                                        Content="Chụp màn hình"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="12,6"
                                        Margin="0,0,10,0"
                                        Click="BtnScreenshot_Click"
                                        ToolTip="Chụp và lưu hình ảnh màn hình từ xa"/>
                                <Border Background="{DynamicResource SurfaceMutedBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="9,5"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Margin="0,0,7,0"/>
                                        <TextBlock Text="TƯƠNG TÁC TRỰC TIẾP" Style="{StaticResource MetricLabelStyle}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Border x:Name="viewportBorder"
                                Grid.Row="1"
                                Margin="12,0,12,12"
                                Background="{DynamicResource ViewportGradientBrush}"
                                BorderBrush="{DynamicResource BorderStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                ClipToBounds="True"
                                Focusable="True"
                                PreviewKeyDown="Viewport_PreviewKeyDown"
                                PreviewKeyUp="Viewport_PreviewKeyUp">
                            <Grid x:Name="viewportGrid">
                                <Image x:Name="imgViewport"
                                       Stretch="Uniform"
                                       Focusable="True"
                                       MouseMove="ImgViewport_MouseMove"
                                       MouseDown="ImgViewport_MouseDown"
                                       MouseUp="ImgViewport_MouseUp"
                                       MouseWheel="ImgViewport_MouseWheel"/>

                                <Border x:Name="overlayPlaceholder"
                                        Background="#CC111A1C"
                                        CornerRadius="12">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="M1,1 L31,1 L31,21 L1,21 Z M10,27 L22,27 M16,21 L16,27"
                                              Width="44"
                                              Height="40"
                                              Stroke="{DynamicResource ConsoleTextBrush}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              HorizontalAlignment="Center"
                                              Margin="0,0,0,14"/>
                                        <TextBlock Text="Đang chờ kết nối từ xa..."
                                                   Foreground="{DynamicResource ConsoleTextBrush}"
                                                   FontFamily="{DynamicResource AppFontFamilySemibold}"
                                                   FontSize="18"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Mở ứng dụng Client trên máy cần hỗ trợ, sau đó nhập IP, cổng và PIN ở bảng bên phải."
                                                   Style="{StaticResource BodyTextStyle}"
                                                   FontSize="13"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="cardStreamSettings" Grid.Row="2" Style="{StaticResource CardStyle}" Padding="18,15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="TỐI ƯU LUỒNG HÌNH" Style="{StaticResource SectionEyebrowStyle}"/>
                                <TextBlock Text="Cân bằng độ nét và độ trễ" Style="{StaticResource BodyTextStyle}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Áp dụng cho Client"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="17,9"
                                    Click="BtnApplyConfig_Click"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Grid>
                                    <TextBlock Text="Chất lượng JPEG" Style="{StaticResource InputLabelStyle}"/>
                                    <TextBlock x:Name="txtQualityVal" Text="100%" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" FontFamily="{DynamicResource AppFontFamilySemibold}" FontSize="11"/>
                                </Grid>
                                <Slider x:Name="sldQuality" Minimum="10" Maximum="100" Value="100" TickFrequency="5" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}" ValueChanged="SldQuality_ValueChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Grid>
                                    <TextBlock Text="Tỉ lệ khung hình" Style="{StaticResource InputLabelStyle}"/>
                                    <TextBlock x:Name="txtScaleVal" Text="1.00x" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" FontFamily="{DynamicResource AppFontFamilySemibold}" FontSize="11"/>
                                </Grid>
                                <Slider x:Name="sldScale" Minimum="0.25" Maximum="1" Value="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}" ValueChanged="SldScale_ValueChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <Grid>
                                    <TextBlock Text="Giới hạn FPS" Style="{StaticResource InputLabelStyle}"/>
                                    <TextBlock x:Name="txtFpsVal" Text="120 FPS" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" FontFamily="{DynamicResource AppFontFamilySemibold}" FontSize="11"/>
                                </Grid>
                                <Slider x:Name="sldFps" Minimum="5" Maximum="120" Value="120" TickFrequency="5" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}" ValueChanged="SldFps_ValueChanged"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Session rail -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="PHIÊN MÁY CHỦ" Style="{StaticResource SectionEyebrowStyle}"/>
                        <TextBlock Text="Sẵn sàng nhận kết nối" Style="{StaticResource CardTitleStyle}" Margin="0,5,0,0"/>
                        <TextBlock Text="Client cần dùng đúng cổng và mã PIN bên dưới."
                                   Style="{StaticResource BodyTextStyle}"
                                   Margin="0,5,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="CỔNG" Style="{StaticResource InputLabelStyle}"/>
                                <TextBox x:Name="txtPort" Text="8888" Style="{StaticResource TextInputStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="MÃ PIN" Style="{StaticResource InputLabelStyle}"/>
                                <TextBox x:Name="txtPin" Text="1234" Style="{StaticResource TextInputStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Button x:Name="btnToggleServer"
                                Content="Dừng máy chủ"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,14,0,0"
                                Click="BtnToggleServer_Click"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel>
                        <Grid Margin="2,0,2,12">
                            <TextBlock Text="HIỆU NĂNG TRỰC TIẾP" Style="{StaticResource SectionEyebrowStyle}"/>
                            <TextBlock Text="LIVE" HorizontalAlignment="Right" Style="{StaticResource MetricLabelStyle}" Foreground="{DynamicResource SuccessBrush}"/>
                        </Grid>
                        <UniformGrid Columns="2" Rows="2">
                            <Border Style="{StaticResource InsetCardStyle}" Margin="0,0,6,6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="TỐC ĐỘ NHẬN" Style="{StaticResource MetricLabelStyle}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock x:Name="txtFps" Text="0.0" Style="{StaticResource MetricValueStyle}" Foreground="{DynamicResource SuccessBrush}"/>
                                        <TextBlock Text=" fps" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Bottom" Margin="3,0,0,4"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InsetCardStyle}" Margin="6,0,0,6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="BĂNG THÔNG" Style="{StaticResource MetricLabelStyle}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock x:Name="txtBandwidth" Text="0.0" Style="{StaticResource MetricValueStyle}" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text=" KB/s" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Bottom" Margin="3,0,0,4"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InsetCardStyle}" Margin="0,6,6,0" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="ĐỘ PHÂN GIẢI" Style="{StaticResource MetricLabelStyle}"/>
                                    <TextBlock x:Name="txtResolution" Text="N/A" Style="{StaticResource MetricValueStyle}" FontSize="16" Margin="0,7,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InsetCardStyle}" Margin="6,6,0,0" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="KÍCH THƯỚC FRAME" Style="{StaticResource MetricLabelStyle}"/>
                                    <TextBlock x:Name="txtFrameSize" Text="0 KB" Style="{StaticResource MetricValueStyle}" FontSize="16" Margin="0,7,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="0" MinHeight="130">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="52"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="16,0">
                            <TextBlock Text="NHẬT KÝ MÁY CHỦ" Style="{StaticResource SectionEyebrowStyle}" VerticalAlignment="Center"/>
                            <Button Content="Xóa" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource TextButtonStyle}" Click="BtnClearLog_Click"/>
                        </Grid>
                        <Border Grid.Row="1"
                                Margin="10,0,10,10"
                                Background="{DynamicResource ConsoleBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="8">
                            <TextBox x:Name="txtLogs" Style="{StaticResource ConsoleTextBoxStyle}"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Floating overlay bar when in Fullscreen -->
        <Border x:Name="pnlFloatingBar"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,12,0,0"
                Background="#E6111A1C"
                BorderBrush="{DynamicResource BorderStrongBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Padding="16,7"
                Panel.ZIndex="999"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Đang ở chế độ Toàn màn hình (Esc hoặc F11 để thoát)"
                           Foreground="{DynamicResource ConsoleTextBrush}"
                           FontFamily="{DynamicResource AppFontFamilySemibold}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0"/>
                <Button Content="Thoát Toàn màn hình"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Padding="12,5"
                        FontSize="11"
                        Click="BtnToggleFullscreen_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
