<Window x:Class="RemoteDesktopServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Desktop Mini - WPF Server"
        Height="780" Width="1200"
        MinHeight="680" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.Resources>
        <!-- Custom Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#374151"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom TextBox Style -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#11131F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Metric Card Label Style -->
        <Style x:Key="MetricTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Panel -->
        <Border Grid.Row="0" Background="{StaticResource CardDarkBrush}" CornerRadius="10" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" Padding="18,14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🖥 REMOTE DESKTOP SERVER" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <Border Background="#059669" CornerRadius="10" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="WPF NATIVE SERVER" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Máy điều khiển (Server) - Nhận luồng hình ảnh &amp; Điều khiển máy bị từ xa qua TCP Socket" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Controls & Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Cổng:" FontSize="12" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="txtPort" Text="8888" Width="60" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,12,0"/>

                        <TextBlock Text="PIN:" FontSize="12" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="txtPin" Text="1234" Width="70" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>

                    <Button x:Name="btnToggleServer" Content="🛑 Dừng Server" Style="{StaticResource ModernButtonStyle}" Click="BtnToggleServer_Click" Margin="0,0,16,0"/>

                    <!-- Status Pill -->
                    <Border x:Name="borderStatusPill" Background="#1F2937" CornerRadius="20" Padding="12,6" VerticalAlignment="Center" BorderBrush="#374151" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ellipseStatus" Width="10" Height="10" Fill="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtStatus" Text="Chờ Client kết nối..." FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Remote Viewport & Control Tuning -->
            <Grid Grid.Column="0" Margin="0,0,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Screen Viewport Container -->
                <Border Grid.Row="0" Background="#07080C" CornerRadius="10" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" ClipToBounds="True" Focusable="True" x:Name="viewportBorder" PreviewKeyDown="Viewport_PreviewKeyDown" PreviewKeyUp="Viewport_PreviewKeyUp">
                    <Grid x:Name="viewportGrid">
                        <!-- Remote Image Stream -->
                        <Image x:Name="imgViewport" Stretch="Uniform" Focusable="True"
                               MouseMove="ImgViewport_MouseMove"
                               MouseDown="ImgViewport_MouseDown"
                               MouseUp="ImgViewport_MouseUp"
                               MouseWheel="ImgViewport_MouseWheel"/>

                        <!-- Placeholder Overlay -->
                        <Border x:Name="overlayPlaceholder" Background="#D00F1117" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📺 CHƯA CÓ KẾT NỐI MÀN HÌNH" FontSize="18" FontWeight="Bold" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Vui lòng khởi chạy Client và nhập đúng địa chỉ IP &amp; Mã PIN để bắt đầu xem và điều khiển." FontSize="12" Foreground="#6B7280" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Dynamic Config Tuning Dashboard -->
                <Border Grid.Row="1" Background="{StaticResource CardDarkBrush}" CornerRadius="10" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" Padding="14" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Quality Slider -->
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Chất lượng JPEG:" FontSize="11" Foreground="White" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="txtQualityVal" Text="55%" FontSize="11" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="sldQuality" Minimum="10" Maximum="100" Value="55" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SldQuality_ValueChanged"/>
                        </StackPanel>

                        <!-- Scale Slider -->
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Tỉ lệ Scale:" FontSize="11" Foreground="White" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="txtScaleVal" Text="0.50x" FontSize="11" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="sldScale" Minimum="0.25" Maximum="1.0" Value="0.5" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="SldScale_ValueChanged"/>
                        </StackPanel>

                        <!-- FPS Slider -->
                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Giới hạn FPS:" FontSize="11" Foreground="White" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="txtFpsVal" Text="30 FPS" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="sldFps" Minimum="5" Maximum="60" Value="30" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SldFps_ValueChanged"/>
                        </StackPanel>

                        <!-- Apply Button -->
                        <Button Grid.Column="3" Content="⚙ Đổi Cấu Hình Client" Style="{StaticResource ModernButtonStyle}" Click="BtnApplyConfig_Click" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right Column: Metrics Dashboard & Logs -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Metrics Cards Grid -->
                <Border Grid.Row="0" Background="{StaticResource CardDarkBrush}" CornerRadius="10" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="THÔNG SỐ MẠNG &amp; LUỒNG HÌNH NHẢNH" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                        <UniformGrid Columns="2" Rows="2">
                            <!-- FPS -->
                            <Border Background="#11131F" CornerRadius="8" Padding="10" Margin="0,0,4,8" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="TỐC ĐỘ NHẬN" Style="{StaticResource MetricTitleStyle}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="txtFps" Text="0.0" Style="{StaticResource MetricValueStyle}" Foreground="#10B981"/>
                                        <TextBlock Text=" FPS" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="3,0,0,2"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Bandwidth -->
                            <Border Background="#11131F" CornerRadius="8" Padding="10" Margin="4,0,0,8" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="BĂNG THÔNG NHẬN" Style="{StaticResource MetricTitleStyle}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="txtBandwidth" Text="0.0" Style="{StaticResource MetricValueStyle}" Foreground="#3B82F6"/>
                                        <TextBlock Text=" KB/s" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="3,0,0,2"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Resolution -->
                            <Border Background="#11131F" CornerRadius="8" Padding="10" Margin="0,0,4,0" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="ĐỘ PHÂN GIẢI CLIENT" Style="{StaticResource MetricTitleStyle}"/>
                                    <TextBlock x:Name="txtResolution" Text="N/A" Style="{StaticResource MetricValueStyle}" Foreground="#F59E0B" FontSize="14"/>
                                </StackPanel>
                            </Border>

                            <!-- Frame Size -->
                            <Border Background="#11131F" CornerRadius="8" Padding="10" Margin="4,0,0,0" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="KÍCH THƯỚC FRAME" Style="{StaticResource MetricTitleStyle}"/>
                                    <TextBlock x:Name="txtFrameSize" Text="0 KB" Style="{StaticResource MetricValueStyle}" Foreground="#8B5CF6" FontSize="14"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Console Logs Card -->
                <Border Grid.Row="1" Background="{StaticResource CardDarkBrush}" CornerRadius="10" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="💻 NHẬT KÝ SERVER" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Button Content="Xóa Logs" FontSize="10" Padding="6,3" Background="#374151" Foreground="White" HorizontalAlignment="Right" Click="BtnClearLog_Click" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <Border Grid.Row="1" Background="#0A0C10" CornerRadius="8" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" Padding="10">
                            <TextBox x:Name="txtLogs" FontFamily="Consolas" FontSize="11" Foreground="#38BDF8" Background="Transparent" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
